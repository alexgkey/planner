<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Planner{% endblock %}</title>
        <link rel="icon" href="{{ '/media/' ~ 'favicon.png' }}" type="image/x-icon" src="">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
        {% block stylesheets %}
            <style>
                body {
                    font-size: .875rem;
                    background-color: #f8f9fa;
                }

                .sidebar {
                    align-self: flex-start;
                }

                .sidebar .nav-link {
                    color: #495057;
                    border-radius: .5rem;
                    padding: .5rem .75rem;
                    font-weight: 500;
                }

                .sidebar .nav-link:hover,
                .sidebar .nav-link:focus {
                    background-color: #eef2f6;
                    color: #212529;
                }

                .sidebar .nav-link.active {
                    background-color: #0d6efd;
                    color: #fff;
                }

                .sidebar-section-title {
                    font-size: .75rem;
                    text-transform: uppercase;
                    letter-spacing: .08em;
                    color: #6c757d;
                    margin-bottom: .75rem;
                }

                .sidebar-extra .card {
                    border: 0;
                    box-shadow: 0 .125rem .25rem rgba(0, 0, 0, .075);
                }

                @media (min-width: 768px) {
                    .sidebar {
                        /*position: fixed;*/
                        top: 48px;
                        bottom: 0;
                        left: 0;
                        z-index: 100;
                        overflow-y: auto;
                    }

                    .app-main {
                        margin-left: 25%;
                        width: 75%;
                    }
                }

                @media (min-width: 992px) {
                    .app-main {
                        margin-left: 16.66666667%;
                        width: 83.33333333%;
                    }
                }

                @media (max-width: 767.98px) {
                    .sidebar {
                        position: static;
                        top: auto;
                        bottom: auto;
                        overflow-y: visible;
                    }

                    .app-main {
                        margin-left: 0;
                        width: 100%;
                    }
                }
            </style>
        {% endblock %}
    </head>
    <body>
    {% if app.user %}
        {% set current_route = app.request.attributes.get('_route') %}
        {% set is_events_route = current_route starts with 'app_event_' %}
        {% set home_route = is_granted(Permissions.EVENT_VIEW) ? path('app_event_index') : (is_granted(Permissions.DEPARTMENT_VIEW) ? path('app_department_index') : (is_granted(Permissions.EMPLOYEE_VIEW) ? path('app_employee_index') : (is_granted(Permissions.USER_VIEW) ? path('app_user_index') : '#'))) %}

        <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow-sm">
            <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6" href="{{ home_route }}">Планировщик</a>
            <div class="navbar-nav flex-row ms-auto align-items-center">
                <button class="navbar-toggler position-static d-md-none me-2" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </header>

        <div class="container-fluid">
            <div class="row align-items-start">
                <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-white sidebar collapse border-end">
                    <div class="pt-3 px-3 pb-4">
                        <div class="sidebar-section-title">Основное меню</div>
                        <ul class="nav flex-column gap-1 mb-4">
                            {% if is_granted(Permissions.EVENT_VIEW) %}
                                <li class="nav-item">
                                    <a href="{{ path('app_event_index') }}" class="nav-link {% if current_route starts with 'app_event_index' %}active{% endif %}">
                                        <i class="bi bi-calendar3 me-2"></i>План
                                    </a>
                                </li>
                            {% endif %}
                            {% if is_granted(Permissions.EVENT_ADMIN) %}
                                <a href="{{ path('app_event_analytics', app.request.query.all) }}" class="nav-link {% if current_route starts with 'app_event_analytics' %}active{% endif %}">
                                    <i class="bi bi-bar-chart-line me-2"></i>Аналитика
                                </a>
                            {% endif %}
                            {% if is_granted(Permissions.DEPARTMENT_VIEW) %}
                                <li class="nav-item">
                                    <a href="{{ path('app_department_index') }}" class="nav-link {% if current_route starts with 'app_department_' %}active{% endif %}">
                                        <i class="bi bi-diagram-3 me-2"></i>Подразделения
                                    </a>
                                </li>
                            {% endif %}

                            {% if is_granted(Permissions.EMPLOYEE_VIEW) %}
                                <li class="nav-item">
                                    <a href="{{ path('app_employee_index') }}" class="nav-link {% if current_route starts with 'app_employee_' %}active{% endif %}">
                                        <i class="bi bi-people me-2"></i>Сотрудники
                                    </a>
                                </li>
                            {% endif %}

                            {% if is_granted(Permissions.USER_VIEW) %}
                                <li class="nav-item">
                                    <a href="{{ path('app_user_index') }}" class="nav-link {% if current_route starts with 'app_user_' %}active{% endif %}">
                                        <i class="bi bi-person-gear me-2"></i>Пользователи
                                    </a>
                                </li>
                            {% endif %}

                            <li class="nav-item">
                                <a href="{{ path('app_logout') }}" class="nav-link">
                                    <i class="bi bi-door-closed me-2"></i>Выход
                                </a>
                            </li>
                        </ul>

                        <div class="sidebar-extra">
                            {% block sidebar_extra %}{% endblock %}
                        </div>
                    </div>
                </nav>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4 app-main">
                    {% block body %}{% endblock %}
                </main>
            </div>
        </div>
    {% else %}
        {{ block('body') }}
    {% endif %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    {% block javascripts %}{% endblock %}
    </body>
</html>
