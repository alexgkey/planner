<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" name="viewport" content="width=device-width, initial-scale=1>
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {# Bootstrap CSS #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
        {% block stylesheets %}
            {# Сюда можно будет добавлять стили для конкретных страниц #}
        {% endblock %}
    </head>
    <body>
    {% if app.user %}
    <header class="d-flex justify-content-center py-3">
        {% set current_route = app.request.attributes.get('_route') %}
        <ul class="nav nav-pills align-items-center">
            <li class="nav-item">
                <a href="{{ path('app_event_index') }}" class="nav-link {% if current_route starts with 'app_event_' %}active{% endif %}">
                    План
                </a>
            </li>
            {% if is_granted('ROLE_MANAGER') %}
                <li class="nav-item">
                    <a href="{{ path('app_calendar') }}" class="nav-link {% if current_route == 'app_calendar' %}active{% endif %}">
                        Календарь
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_department_index') }}" class="nav-link {% if current_route starts with 'app_department_' %}active{% endif %}">
                        Подразделения
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_user_index') }}" class="nav-link {% if current_route starts with 'app_user_' %}active{% endif %}">
                        Пользователи
                    </a>
                </li>
            {% endif %}

            <li class="nav-item ms-3">
                <a href="{{ path('app_instructions') }}" class="nav-link {% if current_route == 'app_instructions' %}active{% endif %}" title="Инструкции">
                    <i class="bi bi-question-circle fs-5"></i>
                </a>
            </li>
            <li class="nav-item ms-3 border-start ps-3">
                <a href="{{ path('app_logout') }}" class="nav-link">Выход</a>
            </li>
        </ul>
    </header>
    {% endif %}

    {% block body %}{% endblock %}

    {# Bootstrap JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    {% block javascripts %}
        {# Сюда можно будет добавлять скрипты для конкретных страниц #}
    {% endblock %}
    </body>
</html>
