{{ form_start(form) }}
    <div class="row g-3">
        <div class="col-md-6">
            {{ form_row(form.title) }}
        </div>
        <div class="col-md-3">
            {{ form_row(form.date) }}
        </div>
        <div class="col-md-3">
            {{ form_row(form.time) }}
        </div>
        <div class="col-12">
            {{ form_row(form.venue) }}
        </div>
        {% if form.department is defined %}
            <div class="col-12">
                {{ form_row(form.department) }}
            </div>
        {% endif %}
        <div class="col-md-6">
            {{ form_row(form.eventLevel) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.onOffLine) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.eventDirection) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.eventAccessibility) }}
        </div>
        <div class="col-12">
            {{ form_row(form.targetAudience) }}
        </div>
        <div class="col-12">
            {{ form_row(form.interaction) }}
        </div>
        <div class="col-12">
            {{ form_row(form.note, {
                attr: {rows: 4}
            }) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.responsible) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.planned_visitors) }}
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a href="{{ path('app_event_index') }}" class="btn btn-secondary">Отмена</a>
        <button class="btn btn-primary">{{ button_label|default('Сохранить') }}</button>
    </div>
{{ form_end(form) }}
