{% extends 'base.html.twig' %}

{% block title %}{{ page_title|default('Новое мероприятие') }}{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 700px;">
        <div class="card shadow-lg border-0">
            <div class="card-body p-4 p-sm-5">
                <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                    <div>
                        <h3 class="mb-1">{{ page_title|default('Новое мероприятие') }}</h3>
                        {% if page_hint is not empty %}
                            <p class="text-muted mb-0">{{ page_hint }}</p>
                        {% endif %}
                    </div>
                    <a href="{{ path('app_event_index') }}" class="btn btn-sm btn-outline-secondary">
                        Назад к списку
                    </a>
                </div>

                {{ include('event/_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}