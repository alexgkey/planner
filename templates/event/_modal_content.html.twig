{# Этот шаблон содержит только внутреннюю часть для модального окна #}
<div class="modal-header">
    <h5 class="modal-title">{{ event.title }}</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <dl class="row gy-3">
        {% if event.date %}
            <dt class="col-sm-4 text-muted">Дата проведения</dt>
            <dd class="col-sm-8">{{ event.date|date('d.m.Y') }}</dd>
        {% endif %}

        {% if event.venue %}
            <dt class="col-sm-4 text-muted">Место проведения</dt>
            <dd class="col-sm-8">{{ event.venue }}</dd>
        {% endif %}

        {% if event.onOffLine %}
            <dt class="col-sm-4 text-muted">Формат</dt>
            <dd class="col-sm-8">{{ event.onOffLine.getLabel() }}</dd>
        {% endif %}

        {% if event.eventLevel %}
            <dt class="col-sm-4 text-muted">Уровень</dt>
            <dd class="col-sm-8">{{ event.eventLevel.getLabel() }}</dd>
        {% endif %}

        {% if event.eventDirection %}
            <dt class="col-sm-4 text-muted">Направление</dt>
            <dd class="col-sm-8">{{ event.eventDirection.getLabel() }}</dd>
        {% endif %}

        {% if event.targetAudience %}
            <dt class="col-sm-4 text-muted">Целевая аудитория</dt>
            <dd class="col-sm-8">{{ event.targetAudience.getLabel() }}</dd>
        {% endif %}

        {% if event.eventAccessibility %}
            <dt class="col-sm-4 text-muted">Доступность</dt>
            <dd class="col-sm-8">{{ event.eventAccessibility.getLabel() }}</dd>
        {% endif %}

        {% if event.interaction %}
            <dt class="col-sm-4 text-muted">Взаимодействие</dt>
            <dd class="col-sm-8">{{ event.interaction }}</dd>
        {% endif %}

        {% if event.responsible %}
            <dt class="col-sm-4 text-muted">Ответственный</dt>
            <dd class="col-sm-8">{{ event.responsible }}</dd>
        {% endif %}

        {% if event.plannedVisitors %}
            <dt class="col-sm-4 text-muted">Посетители (план)</dt>
            <dd class="col-sm-8">{{ event.plannedVisitors }}</dd>
        {% endif %}

        {% if event.note %}
            <dt class="col-sm-4 text-muted">Примечание</dt>
            <dd class="col-sm-8"><p style="white-space: pre-wrap; margin-bottom: 0;">{{ event.note }}</p></dd>
        {% endif %}
    </dl>
</div>
<div class="modal-footer">
    <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn btn-primary">Редактировать</a>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
</div>
