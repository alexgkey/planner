{% extends 'base.html.twig' %}

{% block title %}План мероприятий{% endblock %}

{% block body %}
<div class="container-fluid py-5 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="mb-0 h2">План мероприятий</h1>
            {% if app.user and app.user.department %}
                <p class="text-muted mb-0">{{ app.user.department.title }}</p>
            {% endif %}
        </div>
        {% if is_granted('ROLE_DIR') %} {# <-- ДОБАВЛЕНА ПРОВЕРКА #}
            <a href="{{ path('app_event_new') }}" class="btn btn-primary d-flex align-items-center">
                <i class="bi-plus-lg"></i>
                <span class="d-none d-sm-inline ms-2">Новое событие</span>
            </a>
        {% endif %}
    </div>

    {# === СОБЫТИЯ БЕЗ ДАТЫ === #}
    {% set noDateEvents = events|filter(e => e.date is null) %}
    {% if noDateEvents is not empty %}
        <h4 class="text-muted mb-3">Без даты</h4>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3 mb-5">
            {% for event in noDateEvents %}
                <div class="col">{{ block('event_card') }}</div>
            {% endfor %}
        </div>
    {% endif %}

    {# === СОБЫТИЯ С ДАТОЙ (СГРУППИРОВАННЫЕ ПО МЕСЯЦАМ) === #}
    {% set datedEvents = events|filter(e => e.date is not null)|sort((a, b) => a.date <=> b.date) %}
    {% set currentMonth = null %}

    {% for event in datedEvents %}
        {% set month = event.date|format_datetime(locale='ru', pattern='LLLL yyyy')|capitalize %}

        {% if month != currentMonth %}
            {% if not loop.first %}</div>{% endif %}
            <h4 class="text-muted mb-3 {% if noDateEvents is not empty or currentMonth is not null %}mt-4{% endif %}">{{ month }}</h4>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
            {% set currentMonth = month %}
        {% endif %}

        <div class="col">{{ block('event_card') }}</div>

        {% if loop.last %}</div>{% endif %}
    {% endfor %}

    {% if events is empty %}
        <div class="text-center text-muted py-5">
            <p class="fs-4">Пока нет запланированных событий.</p>
            {% if is_granted('ROLE_DIR') %}
                <p>Начните с создания нового события.</p>
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}

{# === ШАБЛОН КОМПАКТНОЙ КАРТОЧКИ СОБЫТИЯ === #}
{% block event_card %}
<a href="{{ path('app_event_show', {'id': event.id}) }}" class="card h-100 text-decoration-none text-body shadow-sm">
    <div class="card-body p-3 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title mb-0 me-2">{{ event.title }}</h6>
            <div class="text-end text-nowrap">
                {% if event.report %}
                    <span class="badge bg-success" title="Отчет сдан"><i class="bi bi-check-circle-fill"></i></span>
                {% endif %}
                {% if event.date %}
                    <span class="fw-bold text-primary ms-2">{{ event.date|date('d') }}</span>
                    <span class="small text-muted text-uppercase">{{ event.date|format_datetime(locale='ru', pattern='MMM') }}</span>
                {% else %}
                     <span class="badge bg-secondary">?</span>
                {% endif %}
            </div>
        </div>

        <div class="mt-auto pt-2">
            {% if event.venue %}
                <p class="card-text text-muted small mb-1">
                    <small>{{ event.venue }}</small>
                </p>
            {% endif %}
            {% if event.note %}
                <p class="card-text small text-muted" style="font-size: 0.8em; line-height: 1.2;">
                    {{ event.note|slice(0, 80) }}{% if event.note|length > 80 %}...{% endif %}
                </p>
            {% endif %}
        </div>
    </div>
</a>
{% endblock %}
