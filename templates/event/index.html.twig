{% extends 'base.html.twig' %}

{% block title %}План мероприятий{% endblock %}

{% block sidebar_extra %}
    {% if can_filter_months %}
        <hr class="my-4">
        <div class="sidebar-section-title">Фильтры</div>
{#        <div class="card mb-4">#}
{#            <div class="card-body p-3">#}
                {% include 'event/_filters.html.twig' with {
                    filter_action: path('app_event_index'),
                    filter_reset_path: path('app_event_index'),
                    filter_form_id: 'event-filters-form'
                } %}
{#            </div>#}
{#        </div>#}
        <hr class="my-4">

        <div class="sidebar-section-title">Действия</div>
{#        <div class="card">#}
{#            <div class="card-body p-3 d-grid gap-2">#}
                <a href="{{ path('app_event_export_pdf', app.request.query.all) }}" class="nav-link">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Распечатать План
                </a>
                <a href="{{ path('app_event_export_reports_pdf', app.request.query.all) }}" class="nav-link">
                    <i class="bi bi-file-earmark-text me-2"></i>Распечатать Отчеты
                </a>
                {% if is_granted(Permissions.EVENT_ADMIN) %}
                    <a href="{{ path('app_event_export', app.request.query.all) }}" class="nav-link">
                        <i class="bi bi-file-earmark-excel me-2"></i>Экспорт в Excel
                    </a>
                {% endif %}
                <hr class="my-4">
                {% if is_granted(Permissions.EVENT_MANAGE_OWN) or is_granted(Permissions.EVENT_MANAGE_ANY) or is_granted(Permissions.EVENT_ADMIN) %}
                    <a href="{{ path('app_event_new') }}" class="btn btn-primary d-flex align-items-center justify-content-center">
                        <i class="bi bi-plus-lg me-2"></i>Новое мероприятие
                    </a>
                {% endif %}
{#            </div>#}
{#        </div>#}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="mb-0 h2">План мероприятий</h1>
            {% if app.user and app.user.employee.department and not can_filter_departments %}
                <p class="text-muted mb-0">{{ app.user.employee.department.title }}</p>
            {% endif %}
        </div>
    </div>

    {% set showDepartmentMeta = can_filter_departments %}

    {% set noDateEvents = events|filter(e => e.date is null) %}
    {% if noDateEvents is not empty %}
        <h4 class="text-muted mb-3">Без даты</h4>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3 mb-5">
            {% for event in noDateEvents %}
                <div class="col">{{ block('event_card') }}</div>
            {% endfor %}
        </div>
    {% endif %}

    {% set datedEvents = events|filter(e => e.date is not null)|sort((a, b) => a.date <=> b.date) %}
    {% set currentMonth = null %}

    {% for event in datedEvents %}
        {% set month = event.date|format_datetime(locale='ru', pattern='LLLL yyyy')|capitalize %}

        {% if month != currentMonth %}
            {% if not loop.first %}</div>{% endif %}
            <h4 class="text-muted mb-3 {% if noDateEvents is not empty or currentMonth is not null %}mt-4{% endif %}">{{ month }}</h4>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3">
            {% set currentMonth = month %}
        {% endif %}

        <div class="col">{{ block('event_card') }}</div>

        {% if loop.last %}</div>{% endif %}
    {% endfor %}

    {% if events is empty %}
        <div class="text-center text-muted py-5 px-lg-5 bg-light rounded-4 border">
            <p class="fs-4 mb-2">По выбранным фильтрам мероприятий не найдено.</p>
            {% if is_granted(Permissions.EVENT_MANAGE_OWN) %}
                <p class="mb-0">Попробуйте изменить фильтры или создайте новое мероприятие.</p>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}

{% block event_card %}
{% set is_cancelled = event.status.value == 'cancelled' %}
{% set is_completed = event.status.value == 'completed' %}
{% set departmentColor = event.department and event.department.color ? event.department.color : '#dee2e6' %}

<a
    href="{{ path('app_event_show', {'id': event.id}) }}"
    class="card h-100 text-decoration-none text-body shadow-sm {% if is_cancelled %}opacity-50{% endif %}"
    style="border: 2px solid {{ departmentColor }};"
>
    <div class="card-body p-3 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h6 class="card-title mb-0 me-2 {% if is_cancelled %}text-decoration-line-through{% endif %}">{{ event.title }}</h6>
            <div class="text-end text-nowrap">
                {% if is_cancelled %}
                    <span class="badge bg-danger" title="Отменено"><i class="bi bi-x-lg"></i></span>
                {% elseif is_completed %}
                    <span class="badge bg-success" title="Проведено"><i class="bi bi-check-circle-fill"></i></span>
                {% elseif event.report is not null %}
                    <span class="badge bg-info" title="Отчет заполнен"><i class="bi bi-file-text-fill"></i></span>
                {% endif %}

                {% if event.date %}
                    <span class="fw-bold text-primary ms-2">{{ event.date|date('d') }}</span>
                    <span class="small text-muted text-uppercase">{{ event.date|format_datetime(locale='ru', pattern='MMM') }}</span>
                    {% if event.time %}
                        <div class="small text-muted">{{ event.time|date('H:i') }}</div>
                    {% endif %}
                {% else %}
                    <span class="badge bg-secondary">?</span>
                {% endif %}
            </div>
        </div>

        {% if showDepartmentMeta and event.department %}
            <div class="mb-2">
                <span class="badge text-bg-light border" style="border-color: {{ departmentColor }} !important; color: {{ departmentColor }};">
                    {{ event.department.title }}
                </span>
            </div>
        {% endif %}

        <div class="mt-auto pt-2">
            {% if event.venue %}
                <p class="card-text text-muted small mb-1">
                    <small>{{ event.venue }}</small>
                </p>
            {% endif %}
            {% if is_granted(Permissions.EVENT_ADMIN) and event.report is null and event.reportReminderSentCount > 0 %}
                <p class="card-text small text-muted mb-1">
                    Напоминания: {{ event.reportReminderSentCount }}
                    <br><span>Последнее: {{ event.reportReminderLastSentAt ? event.reportReminderLastSentAt|date('d.m.Y H:i') : 'неизвестно' }}</span>
                </p>
            {% endif %}
            {% if event.note %}
                <p class="card-text small text-muted" style="font-size: 0.8em; line-height: 1.2;">
                    {{ event.note|slice(0, 80) }}{% if event.note|length > 80 %}...{% endif %}
                </p>
            {% endif %}
        </div>
    </div>
</a>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if can_filter_months %}
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const storageKey = 'planner-event-filters-v1';
                const form = document.getElementById('event-filters-form');
                const resetLink = document.getElementById('event-filters-reset');

                if (!form) {
                    return;
                }

                const url = new URL(window.location.href);
                const hasMonthParams = url.searchParams.has('months[]');
                const hasDepartmentParams = url.searchParams.has('departments[]');
                const hasUndatedParam = url.searchParams.has('include_undated');
                const hasFilterParams = hasMonthParams || hasDepartmentParams || hasUndatedParam;

                if (!hasFilterParams) {
                    const saved = localStorage.getItem(storageKey);
                    if (saved) {
                        try {
                            const parsed = JSON.parse(saved);
                            const redirectUrl = new URL(window.location.href);
                            (parsed.months || []).forEach(month => redirectUrl.searchParams.append('months[]', month));
                            (parsed.departments || []).forEach(department => redirectUrl.searchParams.append('departments[]', department));
                            redirectUrl.searchParams.set('include_undated', parsed.includeUndated ?? '1');

                            if (redirectUrl.search) {
                                window.location.replace(redirectUrl.toString());
                                return;
                            }
                        } catch (error) {
                            localStorage.removeItem(storageKey);
                        }
                    }
                }

                form.addEventListener('submit', function () {
                    const payload = {
                        months: Array.from(form.querySelectorAll('input[name="months[]"]:checked')).map(input => input.value),
                        departments: Array.from(form.querySelectorAll('input[name="departments[]"]:checked')).map(input => input.value),
                        includeUndated: form.querySelector("select[name='include_undated']")?.value ?? '1',
                    };
                    localStorage.setItem(storageKey, JSON.stringify(payload));
                });

                resetLink.addEventListener('click', function () {
                    localStorage.removeItem(storageKey);
                });

                document.querySelectorAll('[data-select-group]').forEach(button => {
                    button.addEventListener('click', function () {
                        const group = this.dataset.selectGroup;
                        form.querySelectorAll(`input[name="${group}[]"]`).forEach(input => {
                            input.checked = true;
                        });
                    });
                });

                document.querySelectorAll('[data-clear-group]').forEach(button => {
                    button.addEventListener('click', function () {
                        const group = this.dataset.clearGroup;
                        form.querySelectorAll(`input[name="${group}[]"]`).forEach(input => {
                            input.checked = false;
                        });
                    });
                });
            });
        </script>
    {% endif %}
{% endblock %}
