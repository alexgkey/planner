<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <style>
        @page {
            size: A4 landscape;
            margin: 16mm 12mm 16mm 12mm;
        }

        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 10px;
            color: #111;
        }

        .export-date {
            text-align: right;
            font-size: 9px;
            color: #555;
            margin-bottom: 6px;
        }

        .title {
            text-align: center;
            font-size: 14px;
            font-weight: bold;
            line-height: 1.35;
            margin-bottom: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th, td {
            border: 1px solid #444;
            padding: 4px 5px;
            vertical-align: top;
            word-wrap: break-word;
        }

        th {
            text-align: center;
            font-size: 9px;
            background: #efefef;
        }

        td.center {
            text-align: center;
        }

        .no-report {
            color: #6c757d;
            font-style: italic;
            text-align: center;
        }

        .signature {
            margin-top: 18mm;
            width: 100%;
            border-collapse: collapse;
        }

        .signature td {
            border: none;
            padding: 0;
            font-size: 11px;
        }

        .line {
            border-bottom: 1px solid #111;
            height: 18px;
        }

        .signature-note {
            margin-top: 3px;
            font-size: 9px;
            text-align: center;
            color: #444;
        }
    </style>
</head>
<body>
    {% include 'event/_export_header.html.twig' with { export_title: 'Отчеты по мероприятиям' } %}

    <table>
        <thead>
            <tr>
                <th style="width: 4%;">№ п/п</th>
                <th style="width: 15%;">Форма и название мероприятия</th>
                <th style="width: 7%;">Дата проведения</th>
                <th style="width: 7%;">Дата отчета</th>
                <th style="width: 5.5%;">Посетители/ просмотры</th>
                <th style="width: 5.5%;">Участники</th>
                <th style="width: 5.5%;">Инвалиды и ОВЗ</th>
                <th style="width: 5.5%;">Пенсионеры</th>
                <th style="width: 5.5%;">Взрослые</th>
                <th style="width: 5.5%;">Молодежь</th>
                <th style="width: 5.5%;">Дети</th>
                <th style="width: 6%;">Смешанная аудитория</th>
                <th style="width: 6%;">Дети на учете</th>
                <th style="width: 5.5%;">Участники СВО</th>
                <th style="width: 6%;">Семьи участников СВО</th>
                <th style="width: 5.5%;">Молодые семьи</th>
                <th style="width: 5.5%;">Волонтеры</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
                {% set report = event.report %}
                <tr>
                    <td class="center">{{ loop.index }}</td>
                    <td>{{ event.title }}</td>
                    <td class="center">{{ event.date ? event.date|date('d.m.Y') : '' }}</td>
                    <td class="center">{{ report and report.createAt ? report.createAt|date('d.m.Y') : '' }}</td>
                    {% if report %}
                        <td class="center">{{ report.visitorsCount ?? '' }}</td>
                        <td class="center">{{ report.participantsCount ?? '' }}</td>
                        <td class="center">{{ report.disabledVisitorsCount ?? '' }}</td>
                        <td class="center">{{ report.seniorsVisitorsCount ?? '' }}</td>
                        <td class="center">{{ report.adultsVisitorsCount ?? '' }}</td>
                        <td class="center">{{ report.youthVisitorsCount ?? '' }}</td>
                        <td class="center">{{ report.childrenVisitorsCount ?? '' }}</td>
                        <td class="center">{{ report.mixedAudienceCount ?? '' }}</td>
                        <td class="center">{{ report.childrenAtRiskCount ?? '' }}</td>
                        <td class="center">{{ report.smoParticipantsCount ?? '' }}</td>
                        <td class="center">{{ report.smoFamiliesCount ?? '' }}</td>
                        <td class="center">{{ report.youngFamiliesCount ?? '' }}</td>
                        <td class="center">{{ report.volunteersCount ?? '' }}</td>
                    {% else %}
                        <td colspan="13" class="no-report">Отчета нет</td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="17" class="center">По выбранному периоду мероприятий не найдено.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% include 'event/_export_signature.html.twig' %}
</body>
</html>