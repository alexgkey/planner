<form method="get" action="{{ filter_action|default(path('app_event_index')) }}" id="{{ filter_form_id|default('event-filters-form') }}" class="d-flex flex-column gap-3">
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
            Месяцы
            <span class="text-muted ms-1">({{ selected_months|length }})</span>
        </button>
        <div class="dropdown-menu p-3 shadow-sm" style="min-width: 320px; max-width: 360px;">
            <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                <h2 class="h6 mb-0">Месяцы</h2>
                <div class="d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-select-group="months">Отметить все</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-clear-group="months">Снять все</button>
                </div>
            </div>
            <div class="d-grid gap-1">
                {% for month_value, month_label in month_options %}
                    <label class="form-check border rounded px-2 py-1 small w-100 bg-white">
                        <input class="form-check-input me-2" type="checkbox" name="months[]" value="{{ month_value }}" {% if month_value in selected_months %}checked{% endif %}>
                        <span class="form-check-label">{{ ((month_value ~ '-01')|date('Y-m-d'))|format_datetime(locale='ru', pattern='LLLL yyyy')|capitalize }}</span>
                    </label>
                {% endfor %}
            </div>
        </div>
    </div>

    {% if can_filter_departments %}
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                Отделы
                <span class="text-muted ms-1">({{ selected_department_ids|length }})</span>
            </button>
            <div class="dropdown-menu p-3 shadow-sm" style="min-width: 320px; max-width: 360px;">
                <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                    <h2 class="h6 mb-0">Отделы</h2>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-select-group="departments">Отметить все</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-clear-group="departments">Снять все</button>
                    </div>
                </div>
                <div class="d-grid gap-1">
                    {% for department in department_options %}
                        <label class="form-check border rounded px-2 py-1 small w-100 bg-white">
                            <input class="form-check-input me-2" type="checkbox" name="departments[]" value="{{ department.id }}" {% if department.id in selected_department_ids %}checked{% endif %}>
                            <span class="form-check-label">{{ department.title }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    <div>
        <label for="include-undated-filter" class="form-label small text-muted mb-1">Без даты</label>
        <select name="include_undated" id="include-undated-filter" class="form-select form-select-sm">
            <option value="1" {% if include_undated %}selected{% endif %}>Показывать</option>
            <option value="0" {% if not include_undated %}selected{% endif %}>Скрывать</option>
        </select>
    </div>

    <div class="d-flex flex-column gap-2 align-items-stretch">
        <a href="{{ filter_reset_path|default(path('app_event_index')) }}" class="btn btn-outline-secondary" id="event-filters-reset">Сбросить</a>
        <button type="submit" class="btn btn-primary">Применить</button>
    </div>
</form>