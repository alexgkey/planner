{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 800px;">
        {% set is_cancelled = event.status.value == 'cancelled' %}
        {% set is_completed = event.status.value == 'completed' %}
        {% set status_class = '' %}
        {% if is_cancelled %}
            {% set status_class = 'border-danger border-3' %}
        {% elseif is_completed %}
            {% set status_class = 'border-success border-3' %}
        {% endif %}

        <div class="card shadow-lg border-0 {{ status_class }}">
            <div class="card-header bg-light py-3">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                    <h3 class="mb-0 {% if is_cancelled %}text-decoration-line-through text-muted{% endif %}">{{ event.title }}</h3>
                    <a href="{{ path('app_event_index') }}" class="btn btn-sm btn-outline-secondary">
                        Назад к списку
                    </a>
                </div>
            </div>
            <div class="card-body p-4 p-sm-5">
                {% for flash_message in app.flashes('warning') %}
                    <div class="alert alert-warning">{{ flash_message }}</div>
                {% endfor %}
                {% for flash_message in app.flashes('success') %}
                    <div class="alert alert-success">{{ flash_message }}</div>
                {% endfor %}

                <dl class="row gy-3">
                    <dt class="col-sm-4 col-md-3 text-muted">Статус</dt>
                    <dd class="col-sm-8 col-md-9">
                        {% set badge_color = 'primary' %}
                        {% if is_cancelled %}{% set badge_color = 'danger' %}{% endif %}
                        {% if is_completed %}{% set badge_color = 'success' %}{% endif %}
                        <span class="badge bg-{{ badge_color }}">{{ event.status.getLabel() }}</span>
                    </dd>

                    {% if event.date %}<dt class="col-sm-4 col-md-3 text-muted">Дата проведения</dt><dd class="col-sm-8 col-md-9">{{ event.date|date('d.m.Y') }}</dd>{% endif %}
                    {% if event.time %}<dt class="col-sm-4 col-md-3 text-muted">Время проведения</dt><dd class="col-sm-8 col-md-9">{{ event.time|date('H:i') }}</dd>{% endif %}
                    {% if event.venue %}<dt class="col-sm-4 col-md-3 text-muted">Место проведения</dt><dd class="col-sm-8 col-md-9">{{ event.venue }}</dd>{% endif %}
                    {% if event.onOffLine %}<dt class="col-sm-4 col-md-3 text-muted">Формат</dt><dd class="col-sm-8 col-md-9">{{ event.onOffLine.getLabel() }}</dd>{% endif %}
                    {% if event.eventLevel %}<dt class="col-sm-4 col-md-3 text-muted">Уровень</dt><dd class="col-sm-8 col-md-9">{{ event.eventLevel.getLabel() }}</dd>{% endif %}
                    {% if event.eventDirection %}<dt class="col-sm-4 col-md-3 text-muted">Направление</dt><dd class="col-sm-8 col-md-9">{{ event.eventDirection.getLabel() }}</dd>{% endif %}
                    {% if event.targetAudience %}<dt class="col-sm-4 col-md-3 text-muted">Целевая аудитория</dt><dd class="col-sm-8 col-md-9">{{ event.targetAudience.getLabel() }}</dd>{% endif %}
                    {% if event.eventAccessibility %}<dt class="col-sm-4 col-md-3 text-muted">Доступность</dt><dd class="col-sm-8 col-md-9">{{ event.eventAccessibility.getLabel() }}</dd>{% endif %}
                    {% if event.interaction %}<dt class="col-sm-4 col-md-3 text-muted">Взаимодействие</dt><dd class="col-sm-8 col-md-9">{{ event.interaction }}</dd>{% endif %}
                    {% if event.responsible %}<dt class="col-sm-4 col-md-3 text-muted">Ответственный</dt><dd class="col-sm-8 col-md-9">{{ event.responsible }}</dd>{% endif %}
                    {% if event.plannedVisitors %}<dt class="col-sm-4 col-md-3 text-muted">Посетители (план)</dt><dd class="col-sm-8 col-md-9">{{ event.plannedVisitors }}</dd>{% endif %}
                    {% if event.note %}<dt class="col-sm-4 col-md-3 text-muted">Примечание</dt><dd class="col-sm-8 col-md-9"><p style="white-space: pre-wrap; margin-bottom: 0;">{{ event.note }}</p></dd>{% endif %}
                    {% if is_granted(Permissions.EVENT_ADMIN) and event.report is null and event.reportReminderSentCount > 0 %}
                        <dt class="col-sm-4 col-md-3 text-muted">Напоминания</dt>
                        <dd class="col-sm-8 col-md-9">
                            <div>Отправлено: {{ event.reportReminderSentCount }}</div>
                            <div>Последнее: {{ event.reportReminderLastSentAt ? event.reportReminderLastSentAt|date('d.m.Y H:i') : 'неизвестно' }}</div>
                        </dd>
                    {% endif %}
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-end gap-2 flex-wrap">
                {% if can_duplicate %}
                    <a href="{{ path('app_event_duplicate', {'id': event.id}) }}" class="btn btn-outline-primary">Создать копию</a>
                {% endif %}

                {% if is_cancelled %}
                    {% if is_granted(Permissions.EVENT_ADMIN) %}
                        <form method="post" action="{{ path('app_event_restore', {'id': event.id}) }}" onsubmit="return confirm('Вы уверены, что хотите восстановить это мероприятие?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ event.id) }}">
                            <button class="btn btn-success">Восстановить мероприятие</button>
                        </form>
                    {% endif %}
                {% else %}
                    {% if is_granted('EVENT_CANCEL', event) %}
                        <form method="post" action="{{ path('app_event_cancel', {'id': event.id}) }}" onsubmit="return confirm('Вы уверены, что хотите отменить это мероприятие?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ event.id) }}">
                            <button class="btn btn-warning">Отменить мероприятие</button>
                        </form>
                    {% endif %}
                {% endif %}

                {% if is_granted('EVENT_ADD_REPORT', event) %}
                    <a href="{{ path('app_event_report', {'id': event.id}) }}" class="btn btn-success">
                        {% if event.report %}Редактировать отчет{% else %}Заполнить отчет{% endif %}
                    </a>
                {% endif %}

                {% if is_granted('EVENT_EDIT', event) %}
                    <a href="{{ path('app_event_edit', {'id': event.id}) }}" class="btn btn-primary">Редактировать</a>
                    {{ include('event/_delete_form.html.twig') }}
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
