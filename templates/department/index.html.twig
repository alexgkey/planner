{% extends 'base.html.twig' %}

{% block title %}Отделы{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0 h2">Отделы</h1>
            {% if not show_all_departments and app.user and app.user.employee.department %}
                <p class="text-muted mb-0">Показан ваш отдел</p>
            {% endif %}
        </div>

        {% if is_granted(Permissions.DEPARTMENT_ADMIN) %}
            <a href="{{ path('app_department_new') }}" class="btn btn-primary d-flex align-items-center">
                <i class="bi-plus-lg"></i>
                <span class="d-none d-sm-inline ms-2">Новый отдел</span>
            </a>
        {% endif %}
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Адрес</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                {% for department in departments %}
                    <tr>
                        <td>{{ department.title }}</td>
                        <td>{{ department.address ?: '—' }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_department_show', {'id': department.id}) }}" class="btn btn-sm btn-outline-secondary">
                                Просмотр
                            </a>
                            {% if is_granted(Permissions.DEPARTMENT_ADMIN) %}
                                <a href="{{ path('app_department_edit', {'id': department.id}) }}" class="btn btn-sm btn-outline-primary">
                                    Редактировать
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            Пока нет ни одного отдела.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}