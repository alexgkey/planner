{% extends 'base.html.twig' %}

{% block title %}Редактирование отдела{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 700px;">
        <div class="card shadow-lg border-0">
            <div class="card-body p-4 p-sm-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="mb-0">Редактирование отдела</h3>
                    <a href="{{ path('app_department_index') }}" class="btn btn-sm btn-outline-secondary">
                        Назад к списку
                    </a>
                </div>

                {{ include('department/_form.html.twig', {'button_label': 'Обновить'}) }}
            </div>
            <div class="card-footer bg-light d-flex justify-content-end">
                {{ include('department/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}