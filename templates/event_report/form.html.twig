{% extends 'base.html.twig' %}

{% block title %}Отчет по мероприятию: {{ event.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://unpkg.com/filepond/dist/filepond.css" rel="stylesheet">
    <link href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css" rel="stylesheet">
    <style>
        .custom-file-input .file-input-label {
            cursor: pointer;
        }
    </style>
{% endblock %}


{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 900px;">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-light py-3">
                <h4 class="mb-0">Отчет по мероприятию</h4>
                <p class="text-muted mb-0 small">{{ event.title }}</p>
            </div>
            <div class="card-body p-4 p-sm-5">
                {{ form_start(form) }}

                <h5>Количественные показатели</h5>
                <hr class="mt-2">

                <div class="mb-3">
                    <label class="form-label d-block">Тип аудитории</label>
                    <div class="btn-group w-100" role="group" id="audience-type-switcher">
                        <button type="button" class="btn btn-outline-primary" data-value="by_age">По возрастным категориям</button>
                        <button type="button" class="btn btn-outline-primary" data-value="mixed">Смешанная аудитория</button>
                    </div>
                    {{ form_widget(form.audienceType) }}
                </div>

                <div id="audience-by-age-fields">
                    <div class="row g-3">
                        <div class="col-md-6" data-sum-source>{{ form_row(form.childrenVisitorsCount) }}</div>
                        <div class="col-md-6" data-sum-source>{{ form_row(form.youthVisitorsCount) }}</div>
                        <div class="col-md-6" data-sum-source>{{ form_row(form.adultsVisitorsCount) }}</div>
                        <div class="col-md-6" data-sum-source>{{ form_row(form.seniorsVisitorsCount) }}</div>
                    </div>
                    <div class="mt-3 p-3 bg-light rounded text-center">
                        <span class="text-muted">Посетители/просмотры:</span>
                        <strong id="visitors-count-display" class="fs-4">0</strong>
                        <span class="text-muted">(чел.)</span>
                        <div style="display: none;">{{ form_widget(form.visitorsCount) }}</div>
                    </div>
                </div>

                <div id="audience-mixed-fields">
                    <div class="row g-3">
                        <div class="col-md-6">{{ form_row(form.mixedAudienceCount) }}</div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="row g-3 mb-4">
                    <div class="col-md-6">{{ form_row(form.participantsCount) }}</div>
                    <div class="col-md-6">{{ form_row(form.disabledVisitorsCount) }}</div>
                    <div class="col-md-6">{{ form_row(form.childrenAtRiskCount) }}</div>
                    <div class="col-md-6">{{ form_row(form.smoParticipantsCount) }}</div>
                    <div class="col-md-6">{{ form_row(form.smoFamiliesCount) }}</div>
                    <div class="col-md-6">{{ form_row(form.youngFamiliesCount) }}</div>
                    <div class="col-md-6">{{ form_row(form.volunteersCount) }}</div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12">{{ form_row(form.publicReportText) }}</div>

                    <div class="col-12">
                        <label class="form-label">Сценарий (файл)</label>
                        <div class="custom-file-input">
                            <div id="scenario-display-block" class="d-flex align-items-center" {% if not form.vars.data.scenarioName %}style="display: none !important;"{% endif %}>
                                <a href="{{ path('app_report_download_scenario', {'id': event.id, 'report_id': form.vars.data.id}) }}" class="fw-bold">{{ form.vars.data.originalScenarioName ?: form.vars.data.scenarioName }}</a>
                                <button type="button" id="delete-scenario-btn" class="btn btn-sm btn-outline-danger ms-3"><i class="bi bi-trash"></i> Удалить</button>
                            </div>

                            <div id="scenario-upload-block" {% if form.vars.data.scenarioName %}style="display: none;"{% endif %}>
                                <label for="{{ form.scenarioFile['file'].vars.id }}" class="btn btn-outline-primary file-input-label">
                                    <i class="bi bi-upload"></i> Выбрать файл...
                                </label>
                                <span id="scenario-filename-display" class="ms-2 text-muted"></span>
                            </div>

                            <div class="d-none">
                                {{ form_widget(form.scenarioFile['file']) }}
                                {% if form.scenarioFile['delete'] is defined %}
                                    {{ form_widget(form.scenarioFile['delete']) }}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <h5>Фотографии</h5>
                <hr class="mt-2">

                <div id="existing-photos-wrapper">
                    {% if form.vars.data and form.vars.data.photos|length > 0 %}
                        <p class="text-muted small">Уже загружено: <span id="existing-photos-count">{{ form.vars.data.photos|length }}</span> из {{ max_photos }}</p>
                        <div class="row g-2 mb-4" id="existing-photos-container">
                            {% for photo in form.vars.data.photos %}
                                {% if photo.id and photo.imageName %}
                                <div class="col-md-4" data-photo-id="{{ photo.id }}">
                                    <div class="position-relative">
                                        <a href="{{ vich_uploader_asset(photo, 'imageFile') | imagine_filter('report_large') }}" target="_blank">
                                            <img src="{{ vich_uploader_asset(photo, 'imageFile') | imagine_filter('report_thumbnail') }}" alt="Фото" class="img-fluid rounded">
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 delete-photo-btn" title="Удалить фото">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div id="new-photos-block"></div>

                <div style="display: none;">
                    {{ form_row(form.photos) }}
                </div>

                <div class="d-flex justify-content-end gap-2 mt-5">
                    <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn btn-secondary">Отмена</a>
                    <button class="btn btn-primary">Сохранить отчет</button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js"></script>
    <script src="https://unpkg.com/filepond-plugin-file-validate-size/dist/filepond-plugin-file-validate-size.js"></script>
    <script src="https://unpkg.com/filepond/dist/filepond.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- ЛОГИКА ДЛЯ КАСТОМНОГО ПОЛЯ СЦЕНАРИЯ ---
            const scenarioFileInput = document.getElementById('{{ form.scenarioFile["file"].vars.id }}');
            const scenarioDisplayBlock = document.getElementById('scenario-display-block');
            const scenarioUploadBlock = document.getElementById('scenario-upload-block');
            const filenameDisplay = document.getElementById('scenario-filename-display');

            scenarioFileInput.addEventListener('change', function() {
                if (this.files && this.files.length > 0) {
                    filenameDisplay.textContent = this.files[0].name;
                } else {
                    filenameDisplay.textContent = '';
                }
            });

            {% if form.scenarioFile['delete'] is defined %}
                const scenarioDeleteCheckbox = document.getElementById('{{ form.scenarioFile["delete"].vars.id }}');
                const deleteScenarioBtn = document.getElementById('delete-scenario-btn');

                if (deleteScenarioBtn && scenarioDeleteCheckbox) {
                    deleteScenarioBtn.addEventListener('click', function() {
                        scenarioDeleteCheckbox.checked = true;
                        scenarioDisplayBlock.style.display = 'none';
                        scenarioUploadBlock.style.display = 'block';
                        scenarioFileInput.value = '';
                        filenameDisplay.textContent = '';
                    });
                }
            {% endif %}

            // --- ЛОГИКА ПЕРЕКЛЮЧАТЕЛЯ ТИПА АУДИТОРИИ ---
            const switcher = document.getElementById('audience-type-switcher');
            const switcherButtons = switcher.querySelectorAll('button');
            const audienceTypeRadios = document.querySelectorAll('input[name="event_report[audienceType]"]');
            const byAgeFields = document.getElementById('audience-by-age-fields');
            const mixedFields = document.getElementById('audience-mixed-fields');

            function updateSwitcherState() {
                const selectedValue = document.querySelector('input[name="event_report[audienceType]"]:checked').value;
                switcherButtons.forEach(button => {
                    if (button.dataset.value === selectedValue) {
                        button.classList.add('active', 'btn-primary');
                        button.classList.remove('btn-outline-primary');
                    } else {
                        button.classList.remove('active', 'btn-primary');
                        button.classList.add('btn-outline-primary');
                    }
                });
            }

            function toggleAudienceFields() {
                const selectedValue = document.querySelector('input[name="event_report[audienceType]"]:checked').value;
                if (selectedValue === 'by_age') {
                    byAgeFields.style.display = 'block';
                    mixedFields.style.display = 'none';
                } else {
                    byAgeFields.style.display = 'none';
                    mixedFields.style.display = 'block';
                    calculateSum();
                }
            }

            switcherButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const value = this.dataset.value;
                    const targetRadio = document.querySelector(`input[name="event_report[audienceType]"][value="${value}"]`);
                    if (targetRadio) {
                        targetRadio.checked = true;
                        targetRadio.dispatchEvent(new Event('change'));
                    }
                });
            });

            audienceTypeRadios.forEach(radio => {
                radio.addEventListener('change', () => {
                    toggleAudienceFields();
                    updateSwitcherState();
                });
            });

            // --- ЛОГИКА АВТОСУММЫ ---
            const visitorsCountInput = document.getElementById('event_report_visitorsCount');
            const visitorsCountDisplay = document.getElementById('visitors-count-display');
            const sumSourceInputs = document.querySelectorAll('#audience-by-age-fields [data-sum-source] input');

            function calculateSum() {
                let total = 0;
                sumSourceInputs.forEach(input => {
                    total += parseInt(input.value) || 0;
                });
                visitorsCountInput.value = total;
                visitorsCountDisplay.innerText = total;
            }

            sumSourceInputs.forEach(input => {
                input.addEventListener('input', calculateSum);
            });

            // --- ЛОГИКА FILEPOND ---
            const maxPhotosTotal = {{ max_photos|default(3) }};
            const newPhotosBlock = document.getElementById('new-photos-block');
            const hiddenInput = document.querySelector('#event_report_photos');
            let pond = null;
            let serverFileIds = [];

            function updateFilePondState() {
                const existingPhotosCount = document.querySelectorAll('#existing-photos-container [data-photo-id]').length;
                const maxFiles = maxPhotosTotal - existingPhotosCount;

                if (pond) {
                    pond.destroy();
                    pond = null;
                }

                newPhotosBlock.innerHTML = '';

                if (maxFiles > 0) {
                    const inputElement = document.createElement('input');
                    inputElement.type = 'file';
                    inputElement.name = 'filepond';
                    inputElement.multiple = true;
                    newPhotosBlock.appendChild(inputElement);

                    pond = FilePond.create(inputElement, {
                        labelIdle: `Перетащите файлы или <span class="filepond--label-action">Обзор</span> (осталось: ${maxFiles})`,
                        acceptedFileTypes: ['image/png', 'image/jpeg'],
                        maxFiles: maxFiles,
                        maxFileSize: '5MB',
                        labelMaxFileSizeExceeded: 'Файл слишком большой',
                        labelMaxFileSize: 'Максимальный размер файла: {filesize}',

                        server: {
                            process: '{{ path('api_photo_upload') }}',
                            revert: '{{ path('api_photo_revert') }}',
                        },
                        onprocessfile: (error, file) => {
                            if (error) return;
                            serverFileIds.push(file.serverId);
                            hiddenInput.value = serverFileIds.join(',');
                        },
                        onremovefile: (error, file) => {
                            if (error) return;
                            const index = serverFileIds.indexOf(file.serverId);
                            if (index > -1) serverFileIds.splice(index, 1);
                            hiddenInput.value = serverFileIds.join(',');
                        }
                    });
                } else {
                    newPhotosBlock.innerHTML = `<p class="text-muted">Вы достигли лимита в ${maxPhotosTotal} фотографии.</p>`;
                }
            }

            document.querySelectorAll('.delete-photo-btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (!confirm('Вы уверены, что хотите удалить это фото?')) return;

                    const photoContainer = this.closest('[data-photo-id]');
                    const photoId = photoContainer.dataset.photoId;

                    fetch(`/api/photos/${photoId}`, { method: 'DELETE' })
                        .then(response => {
                            if (response.ok) {
                                photoContainer.remove();
                                const countSpan = document.getElementById('existing-photos-count');
                                if(countSpan) countSpan.innerText = document.querySelectorAll('#existing-photos-container [data-photo-id]').length;
                                updateFilePondState();
                            } else {
                                alert('Не удалось удалить фото.');
                            }
                        });
                });
            });

            FilePond.registerPlugin(
                FilePondPluginImagePreview,
                FilePondPluginFileValidateType,
                FilePondPluginFileValidateSize
            );

            // --- ИНИЦИАЛИЗАЦИЯ ---
            updateSwitcherState();
            toggleAudienceFields();
            calculateSum();
            updateFilePondState();
        });
    </script>
{% endblock %}
