{% extends 'base.html.twig' %}

{% block title %}Табель{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .timesheet-table {
            min-width: 960px;
        }

        .timesheet-table th,
        .timesheet-table td {
            vertical-align: middle;
            text-align: center;
            white-space: nowrap;
        }

        .timesheet-table__employee {
            position: sticky;
            left: 0;
            z-index: 2;
            min-width: 260px;
            text-align: left !important;
            background-color: #fff;
        }

        .timesheet-table thead .timesheet-table__employee {
            z-index: 3;
            background-color: #f8f9fa;
        }

        .timesheet-table__department-row th {
            position: sticky;
            left: 0;
            z-index: 1;
            background: #eef4ff;
            text-align: left;
            font-size: .875rem;
            letter-spacing: .02em;
        }

        .timesheet-table__today {
            background-color: #ffe8a3;
            box-shadow: inset 2px 0 0 #e0b300, inset -2px 0 0 #e0b300;
        }

        .timesheet-table thead .timesheet-table__today {
            background-color: #ffd966;
        }

        .timesheet-table tbody .timesheet-table__today {
            background-color: #fff3c4;
        }

        .timesheet-table__cell-form select {
            min-width: 88px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Табель</h1>
            {% if show_all_scope %}
                <p class="text-muted mb-0">Показаны сотрудники всех отделов.</p>
            {% elseif show_department_scope %}
                <p class="text-muted mb-0">Показаны сотрудники вашего отдела.</p>
            {% else %}
                <p class="text-muted mb-0">Показан только ваш табель.</p>
            {% endif %}
        </div>

        <form method="get" action="{{ path('app_timesheet_index') }}" class="row g-2 align-items-end">
            <div class="col-sm-auto">
                <label for="date-from" class="form-label mb-1">От</label>
                <input id="date-from" type="date" name="date_from" value="{{ date_from|date('Y-m-d') }}" class="form-control">
            </div>
            <div class="col-sm-auto">
                <label for="date-to" class="form-label mb-1">До</label>
                <input id="date-to" type="date" name="date_to" value="{{ date_to|date('Y-m-d') }}" class="form-control">
            </div>
            <div class="col-sm-auto">
                <button class="btn btn-primary">Показать</button>
            </div>
        </form>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <div class="small text-muted">
                Условные обозначения: Р - рабочий день, О - отгул, Отп - отпуск, Н - неявка, Б - больничный.
                {% if not can_manage_any %}
                    Прошедшие даты доступны только для просмотра.
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0 timesheet-table">
                    <thead class="table-light">
                        <tr>
                            <th class="timesheet-table__employee">Сотрудник</th>
                            {% set day_names = {1: 'Пн', 2: 'Вт', 3: 'Ср', 4: 'Чт', 5: 'Пт', 6: 'Сб', 7: 'Вс'} %}
                            {% for date in dates %}
                                {% set is_today = date|date('Y-m-d') == today|date('Y-m-d') %}
                                <th class="{% if is_today %}timesheet-table__today{% endif %}">
                                    <div>{{ date|date('d.m') }}</div>
                                    <div class="small text-muted">{{ day_names[date|date('N')] }}</div>
                                </th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                    {% for group in grouped_employees %}
                        <tr class="timesheet-table__department-row">
                            <th colspan="{{ dates|length + 1 }}">
                                {{ group.department ? group.department.title : 'Без отдела' }}
                            </th>
                        </tr>

                        {% for employee in group.employees %}
                            <tr>
                                <th class="timesheet-table__employee">
                                    <div class="fw-semibold">{{ employee.fio }}</div>
                                    {% if employee.department %}
                                        <div class="small text-muted">{{ employee.department.title }}</div>
                                    {% endif %}
                                </th>
                                {% for date in dates %}
                                    {% set date_key = date|date('Y-m-d') %}
                                    {% set status = entries_map[employee.id][date_key] ?? null %}
                                    {% set can_edit = access_service.canEditDate(app.user, employee, date) %}
                                    {% set is_today = date_key == today|date('Y-m-d') %}
                                    <td class="{% if is_today %}timesheet-table__today{% endif %}">
                                        {% if can_edit %}
                                            <form method="post" action="{{ path('app_timesheet_update') }}" class="timesheet-table__cell-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('timesheet_update') }}">
                                                <input type="hidden" name="employee_id" value="{{ employee.id }}">
                                                <input type="hidden" name="work_date" value="{{ date_key }}">
                                                <input type="hidden" name="date_from" value="{{ date_from|date('Y-m-d') }}">
                                                <input type="hidden" name="date_to" value="{{ date_to|date('Y-m-d') }}">
                                                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                                    <option value="">-</option>
                                                    {% for label, option in status_choices %}
                                                        <option value="{{ option.value }}" {% if status and status.value == option.value %}selected{% endif %}>
                                                            {{ option.code }}
                                                        </option>
                                                    {% endfor %}
                                                </select>
                                            </form>
                                        {% else %}
                                            <span class="fw-semibold">{{ status ? status.code : '' }}</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="{{ dates|length + 1 }}" class="text-center text-muted py-4">Нет сотрудников для отображения.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
