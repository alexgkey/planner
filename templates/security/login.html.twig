{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row min-vh-100">
        {# Колонка для брендинга, видна только на больших экранах #}
        <div class="col-lg-7 col-xl-8 d-none d-lg-flex align-items-center justify-content-center bg-light">
             <div class="p-5 text-center">
                <h1 class="display-4">Календарь мероприятий</h1>
                <p class="lead">учреждений культуры Усть-Илимского района</p>
            </div>
        </div>

        {# Колонка с формой входа #}
        <div class="col-lg-5 col-xl-4 d-flex flex-column justify-content-start justify-content-lg-center p-4 p-sm-5 auth-form">

            <div class="w-100" margin: auto;">
                <div class="text-center mb-5">
                    <h4 class="fs-1 mb-1">
                        Вход в систему
                    </h4>
                    <p class="text-muted">Пожалуйста, введите ваши данные.</p>
                </div>


                {% if error %}
                    <div class="alert alert-danger text-center small">
                        Неверный email или пароль
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info text-center small">
                        Вы уже вошли как <strong>{{ app.user.userIdentifier }}</strong>
                        <div class="mt-2">
                            <a class="btn btn-outline-primary btn-sm" href="{{ logout_path() }}">
                                Выйти
                            </a>
                        </div>
                    </div>
                {% endif %}

                <form method="post" novalidate>

                    <div class="mb-3">
                        <label for="username" class="form-label">Email</label>
                        <input
                            type="email"
                            name="_username"
                            id="username"
                            class="form-control form-control-lg"
                            value="{{ last_username }}"
                            required
                            autocomplete="email"
                            autofocus
                        >
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Пароль</label>
                        <input
                            type="password"
                            name="_password"
                            id="password"
                            class="form-control form-control-lg"
                            required
                            autocomplete="current-password"
                        >
                    </div>

                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('authenticate') }}">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me" checked>
                            <label class="form-check-label" for="_remember_me">
                                Запомнить меня
                            </label>
                        </div>
                        {# Можно добавить ссылку на восстановление пароля #}
                        {# <a href="#" class="text-decoration-none small">Забыли пароль?</a> #}
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg">
                            Войти
                        </button>
                    </div>

                </form>

                <p class="text-center text-muted small mt-5">
                    Календарь мероприятий © {{ "now"|date("Y") }}
                </p>
            </div>

        </div>
    </div>
</div>
{% endblock %}
