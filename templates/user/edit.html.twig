{% extends 'base.html.twig' %}

{% block title %}Редактирование пользователя{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0 h2">Редактирование пользователя</h1>
        <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-secondary">
            Назад к списку
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4 p-sm-5">
            {{ include('user/_form.html.twig', {'button_label': 'Обновить'}) }}
        </div>
    </div>

    {% if is_granted(Permissions.USER_ADMIN) %}
        <div class="mt-4 p-4 border border-danger rounded">
            <h5 class="text-danger">Опасная зона</h5>
            <p>Это действие нельзя будет отменить.</p>
            {{ include('user/_delete_form.html.twig') }}
        </div>
    {% endif %}
</div>
{% endblock %}