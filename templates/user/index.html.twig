{% extends 'base.html.twig' %}

{% block title %}Список пользователей{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0 h2">Пользователи</h1>
        <a href="{{ path('app_user_new') }}" class="btn btn-primary d-flex align-items-center">
            <i class="bi-plus-lg"></i>
            <span class="d-none d-sm-inline ms-2">Новый пользователь</span>
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>ФИО</th>
                        <th>Телефон</th>
                        <th>Отдел</th>
                        <th>Роли</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.email }}</td>
                        <td>{{ user.fio }}</td>
                        <td>{{ user.phone }}</td>
                        <td>{{ user.department ? user.department.title : 'Не указан' }}</td>
                        <td>
                            {# --- НАЧАЛО БЛОКА ОТОБРАЖЕНИЯ РОЛЕЙ --- #}
                            {% set role_names = user_roles|flip %}

                            {% set displayed_roles = [] %}
                            {% for role in user.roles %}
                                {% if role_names[role] is defined %}
                                    {% set displayed_roles = displayed_roles|merge([role_names[role]]) %}
                                {% endif %}
                            {% endfor %}

                            {{ displayed_roles|join(', ') }}
                            {# --- КОНЕЦ БЛОКА ОТОБРАЖЕНИЯ РОЛЕЙ --- #}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary">
                                Просмотр
                            </a>
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary">
                                Редактировать
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            Пока нет ни одного пользователя.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
