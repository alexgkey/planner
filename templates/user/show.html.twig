{% extends 'base.html.twig' %}

{% block title %}{{ user.email }}{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 800px;">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-light py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">{{ user.email }}</h3>
                    <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-secondary">
                        Назад к списку
                    </a>
                </div>
            </div>
            <div class="card-body p-4 p-sm-5">
                <dl class="row">
                    <dt class="col-sm-3 text-muted">Email</dt>
                    <dd class="col-sm-9">{{ user.email }}</dd>

                    <dt class="col-sm-3 text-muted">ФИО</dt>
                    <dd class="col-sm-9">{{ user.employee.fio }}</dd>

                    <dt class="col-sm-3 text-muted">Телефон</dt>
                    <dd class="col-sm-9">{{ user.employee.phone }}</dd>

                    <dt class="col-sm-3 text-muted">Отдел</dt>
                    <dd class="col-sm-9">{{ user.employee.department ? user.employee.department.title : 'Не указан' }}</dd>

                    {% if is_granted(Permissions.USER_ADMIN) %}
                        <dt class="col-sm-3 text-muted">Разрешения</dt>
                        <dd class="col-sm-9">
                            {% if user.permissions|length > 0 %}
                                {{ user.permissions|join(', ') }}
                            {% else %}
                                <span class="text-muted">Нет специальных разрешений</span>
                            {% endif %}
                        </dd>
                    {% endif %}
                </dl>
            </div>
            <div class="card-footer bg-light d-flex justify-content-end gap-2">
                {% if is_granted(Permissions.USER_MANAGE_ALL, user) or is_granted(Permissions.USER_MANAGE_OWN, user) %}
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-primary">Редактировать</a>
                {% endif %}
                {% if is_granted(Permissions.USER_ADMIN) %}
                    {{ include('user/_delete_form.html.twig') }}
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
