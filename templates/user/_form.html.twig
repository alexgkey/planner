{{ form_start(form) }}
    <div class="row g-3">
        <div class="col-12">
            {{ form_row(form.employee) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.email) }}
        </div>
        <div class="col-md-6">
            {{ form_row(form.password) }}
        </div>

        {# Поле с разрешениями показываем только если оно добавлено в форме. #}
        {% if form.permissions is defined %}
            <div class="col-12 mt-3">
                {{ form_row(form.permissions) }}
            </div>
        {% endif %}
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Отмена</a>
        <button class="btn btn-primary">{{ button_label|default('Сохранить') }}</button>
    </div>
{{ form_end(form) }}