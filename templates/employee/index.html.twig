{% extends 'base.html.twig' %}

{% block title %}Сотрудники{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0 h2">Сотрудники</h1>
            {% if show_all_scope %}
                <p class="text-muted mb-0">Показаны сотрудники всех отделов</p>
            {% elseif show_department_scope %}
                <p class="text-muted mb-0">Показаны сотрудники вашего отдела</p>
            {% else %}
                <p class="text-muted mb-0">Показана только ваша карточка сотрудника</p>
            {% endif %}
        </div>

        {% if is_granted(Permissions.EMPLOYEE_MANAGE_DEPARTMENT) or is_granted(Permissions.EMPLOYEE_MANAGE_ANY) or is_granted(Permissions.EMPLOYEE_ADMIN) %}
            <a href="{{ path('app_employee_new') }}" class="btn btn-primary">Добавить сотрудника</a>
        {% endif %}
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ф.И.О.</th>
                        <th>Отдел</th>
                        <th>Телефон</th>
                        <th>Аккаунт</th>
                        <th class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                {% for employee in employees %}
                    <tr>
                        <td>{{ employee.fio }}</td>
                        <td>{{ employee.department ? employee.department.title : '—' }}</td>
                        <td>{{ employee.phone ?: '—' }}</td>
                        <td>{{ employee.userAccount ? employee.userAccount.email : 'Нет' }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-sm btn-outline-secondary">Просмотр</a>
                            {% if is_granted('EMPLOYEE_EDIT', employee) %}
                                <a href="{{ path('app_employee_edit', {'id': employee.id}) }}" class="btn btn-sm btn-outline-primary">Редактировать</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Нет сотрудников</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}