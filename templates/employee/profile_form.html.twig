{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 760px;">
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center gap-3 flex-wrap">
            <div>
                <h1 class="mb-0 h3">{{ page_title }}</h1>
                <p class="text-muted mb-0">Сотрудник: {{ employee.fio }}</p>
            </div>
            <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-sm btn-outline-secondary">Назад к карточке</a>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="{{ path('app_employee_show', {'id': employee.id}) }}" class="btn btn-secondary">Отмена</a>
                    <button class="btn btn-primary">Сохранить</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}