{% extends 'base.html.twig' %}

{% block title %}
    Ошибка {{ status_code }}
{% endblock %}

{% block body %}
    <div class="min-vh-100 d-flex align-items-center justify-content-center px-3">

        <div class="w-100 text-center" style="max-width: 480px;">

            <h1 class="display-4 fw-bold mb-3">
                {{ status_code }}
            </h1>

            <p class="lead mb-4">
                {{ message }}
            </p>

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    Назад
                </a>

                <a href="{{ path('app_login') }}" class="btn btn-primary">
                    Войти
                </a>
            </div>

            <hr class="my-4">

            <p class="text-muted small">
                Если ошибка повторяется, обратитесь к руководителю
            </p>

        </div>

    </div>
{% endblock %}
